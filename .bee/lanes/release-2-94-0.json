          "truths": [
            "both plugin manifests report 2.94.0",
            "tag v2.94.0 exists locally and on the remote",
            "the GitHub release for v2.94.0 carries the binaries and SHA256SUMS",
            "the script printed its final OK line"
          ],
          "artifacts": [
            {
              "path": ".claude-plugin/plugin.json",
              "substantive": "version 2.94.0"
            },
            {
              "path": ".codex-plugin/plugin.json",
              "substantive": "version 2.94.0"
            }
