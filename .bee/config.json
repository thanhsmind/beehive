{
  "hooks": {
    "session-init": true,
    "prompt-context": true,
    "state-sync": true,
    "chain-nudge": true,
    "session-close": true,
    "write-guard": true
  },
  "commands": {
    "test": "PATH=\"${CARGO_HOME:-$HOME/.cargo}/bin:$PATH\" cargo test --release --no-fail-fast --manifest-path packages/bee-rs/Cargo.toml"
  },
  "gate_bypass": "normal",
  "ship_visibility": "off",
  "worktree_first": "on",
  "worktree_cleanup_on_merge": false,
  "uat_stop": "close",
  "uat_before_merge": false,
  "staging_before_merge": false,
  "models": {
    "claude": {
      "code": {
        "model": "opus",
        "description": "write the cell's Rust code and its tests"
      },
      "read": {
        "kind": "herding",
        "agent": "agy-flash",
        "description": "multi-file gathers and codebase scans, read-only"
      },
      "test": {
        "model": "opus",
        "description": "author or repair tests, red-first"
      },
      "docs": {
        "model": "opus",
        "description": "doc edits and parity sweeps"
      },
      "extraction": {
        "kind": "herding",
        "agent": "agy-flash",
        "description": "narrow fact lookups from known locations"
      },
      "generation": {
        "kind": "herding",
        "agent": "agy-flash",
        "description": "fall-through tail: default writer role"
      },
      "review": {
        "model": "opus",
        "description": "independent read-only check of a claim or diff"
      },
      "advisor": {
        "model": "fable",
        "description": "session-class consult for high-risk gates"
      },
      "supervisor": {
        "model": "haiku",
        "description": "cold observer tick — structured observation on a cheap model; decides nothing, escalation rides the advisor role"
      },
      "lane-1": {
        "model": "fable",
        "description": "blind-lane seat 1 — isolated design proposal; three seats run three different brains on one identical brief"
      },
      "lane-2": {
        "model": "opus",
        "description": "blind-lane seat 2 — isolated design proposal; three seats run three different brains on one identical brief"
      },
      "lane-3": {
        "model": "sonnet",
        "description": "blind-lane seat 3 — isolated design proposal; three seats run three different brains on one identical brief"
      },
      "hat-facts-gaps": {
        "model": "opus",
        "description": "hat: what the spec cannot answer — 5-Layer rubric + Truth Table Test"
      },
      "hat-risks": {
        "model": "fable",
        "description": "hat: what breaks, and can it be undone — CRUD lifecycle, the delete half is the reversibility interrogation"
      },
      "hat-value": {
        "model": "sonnet",
        "description": "hat: is this worth its cost — materiality test"
      },
      "hat-alternatives": {
        "model": "opus",
        "description": "hat: is there a cheaper shape — the SMALLER PATH question at spec altitude"
      },
      "hat-user-impact": {
        "model": "sonnet",
        "description": "hat: what the user sees and feels — gray-area probes + the SEE mock"
      }
    },
    "codex": {
      "extraction": "gpt-5.5",
      "generation": "gpt-5.5",
      "review": {
        "kind": "cli",
        "command": "codex exec -m gpt-5.5 -s read-only -c model_reasoning_effort=\"high\" -",
        "promptVia": "stdin"
      }
    }
  },
  "herding": {
    "agent_command": "claude-sonnet",
    "control_command": [
      "claude",
      "-p",
      "{PROMPT}",
      "--model",
      "sonnet",
      "--max-turns",
      "{MAX_TURNS}",
      "--allowedTools",
      "{ALLOWED_TOOLS}"
    ],
    "agents": {
      "claude-sonnet": [
        "claude",
        "--model",
        "sonnet",
        "--permission-mode",
        "bypassPermissions"
      ],
      "pi-opencode-free": [
        "pi",
        "-a",
        "--model",
        "opencode/x-preview-f-free:high"
      ],
      "pi-agy-flash-3.7": [
        "pi",
        "-a",
        "--model",
        "agy/gemini-3.7-flash:high"
      ],
      "agy-flash": {
        "argv": [
          "agy",
          "--dangerously-skip-permissions"
        ],
        "workspace_trust": {
          "file": "~/.gemini/antigravity-cli/settings.json",
          "key": "trustedWorkspaces"
        }
      }
    }
  }
}