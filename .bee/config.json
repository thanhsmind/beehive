{
  "hooks": {
    "session-init": true,
    "prompt-context": true,
    "state-sync": true,
    "chain-nudge": true,
    "session-close": true,
    "write-guard": true
  },
  "commands": {
    "test": "PATH=\"${CARGO_HOME:-$HOME/.cargo}/bin:$PATH\" cargo test --release --no-fail-fast --manifest-path packages/bee-rs/Cargo.toml"
  },
  "gate_bypass": "normal",
  "ship_visibility": "off",
  "worktree_first": "on",
  "worktree_cleanup_on_merge": false,
  "uat_stop": "close",
  "uat_before_merge": false,
  "staging_before_merge": false,
  "models": {
    "claude": {
      "code": {
        "model": "opus",
        "description": "write the cell's Rust code and its tests"
      },
      "read": {
        "model": "sonnet",
        "description": "multi-file gathers and codebase scans, read-only"
      },
      "test": {
        "model": "opus",
        "description": "author or repair tests, red-first"
      },
      "docs": {
        "model": "sonnet",
        "description": "mechanical doc edits and parity sweeps"
      },
      "extraction": {
        "model": "sonnet",
        "description": "narrow fact lookups from known locations"
      },
      "generation": {
        "model": "opus",
        "description": "fall-through tail: default writer role"
      },
      "review": {
        "model": "opus",
        "description": "independent read-only check of a claim or diff"
      },
      "advisor": {
        "model": "fable",
        "description": "session-class consult for high-risk gates"
      }
    },
    "codex": {
      "extraction": "gpt-5.5",
      "generation": "gpt-5.5",
      "review": {
        "kind": "cli",
        "command": "codex exec -m gpt-5.5 -s read-only -c model_reasoning_effort=\"high\" -",
        "promptVia": "stdin"
      }
    }
  },
  "herding": {
    "agent_command": "claude-sonnet",
    "control_command": [
      "claude",
      "-p",
      "{PROMPT}",
      "--model",
      "sonnet",
      "--max-turns",
      "{MAX_TURNS}",
      "--allowedTools",
      "{ALLOWED_TOOLS}"
    ],
    "agents": {
      "claude-sonnet": [
        "claude",
        "--model",
        "sonnet",
        "--permission-mode",
        "bypassPermissions"
      ],
      "pi-opencode-free": [
        "pi",
        "-a",
        "--model",
        "opencode/x-preview-f-free:high"
      ],
      "pi-agy-flash-3.7": [
        "pi",
        "-a",
        "--model",
        "agy/gemini-3.7-flash:high"
      ],
      "agy-flash": {
        "argv": [
          "agy",
          "--dangerously-skip-permissions"
        ],
        "workspace_trust": {
          "file": "~/.gemini/antigravity-cli/settings.json",
          "key": "trustedWorkspaces"
        }
      }
    }
  }
}
