{
  "output_spill_bytes": 8000,
  "hooks": {
    "session-init": true,
    "prompt-context": true,
    "state-sync": true,
    "chain-nudge": true,
    "session-close": true,
    "write-guard": true
  },
  "commands": {
    "test": [
      "PATH=\"${CARGO_HOME:-$HOME/.cargo}/bin:$PATH\" cargo clippy --manifest-path packages/bee-rs/Cargo.toml -- -D warnings",
      "PATH=\"${CARGO_HOME:-$HOME/.cargo}/bin:$PATH\" cargo test --release --no-fail-fast --manifest-path packages/bee-rs/Cargo.toml"
    ]
  },
  "host_shell": "posix",
  "gate_bypass": "full",
  "ship_visibility": "off",
  "worktree_first": "on",
  "worktree_cleanup_on_merge": false,
  "uat_stop": "close",
  "uat_before_merge": false,
  "staging_before_merge": false,
  "bee_report": {
    "ingest": true
  },
  "herding": {
    "ceiling_seconds": 1800,
    "control_command": [
      "claude",
      "-p",
      "{PROMPT}",
      "--model",
      "claude-fable-5-1",
      "--max-turns",
      "{MAX_TURNS}",
      "--allowedTools",
      "{ALLOWED_TOOLS}"
    ]
  },
  "handoff_context_tokens": 0,
  "design": {
    "packs": [
      "web",
      "charts"
    ]
  },
  "skillstation": {
    "principles": "hub"
  },
  "guards": {
    "cross_project_allow": [
      "/home/thanhsmind/Projects/refs/ai-skills/cursor-plugins/pstack"
    ]
  }
}
