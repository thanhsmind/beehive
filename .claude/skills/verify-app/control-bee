case "${1:-}" in
  build)    shift; cmd_build "$@" ;;
  bin)      shift; cmd_bin "$@" ;;
  paths)    shift; cmd_paths "$@" ;;
  launch)   shift; cmd_launch "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  cli)      shift; cmd_cli "$@" ;;
  sh)       shift; cmd_sh "$@" ;;
  put)      shift; cmd_put "$@" ;;
  host)     shift; cmd_host "$@" ;;
  newrepo)  shift; cmd_newrepo "$@" ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  cleanup)  shift; cmd_cleanup "$@" ;;
  smoke)    shift; cmd_smoke "$@" ;;
  drive)    shift; cmd_drive "$@" ;;
  ""|-h|--help) sed -n '2,34p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; printf '  control-bee drive (--fast|--full)  drive mapped features\n' ;;
  *) die "unknown subcommand '$1' — run 'control-bee --help'" ;;
esac
