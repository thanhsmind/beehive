drive_feature() {
  local feat="$1" fn="$2" note="${3:-}"
  local id="drive-${feat}-$(date +%Y%m%d-%H%M%S)-$$"
  local ev="$VERIFY_HOME/evidence/$id"
  local rd="$VERIFY_HOME/run/$id"
  mkdir -p "$ev"
  local rc
  set +e
  (
    set -e
    SMOKE_RUN=1; export SMOKE_RUN
    VERIFY_RUN="$id"; export VERIFY_RUN
    unset VERIFY_CWD
    isolate_global_config
    printf 'launch' > "$ev/drive-check"
    cmd_launch > "$ev/drive.log" 2>&1
    printf 'doctor' > "$ev/drive-check"
    cmd_doctor >> "$ev/drive.log" 2>&1
    "$fn" >> "$ev/drive.log" 2>&1
  )
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    rm -f "$ev/drive-check"
    VERIFY_RUN="$id" SMOKE_RUN=1 cmd_cleanup > /dev/null 2>&1 || true
    if [ -n "$note" ]; then
      ok "$feat ($note)"
    else
      ok "$feat"
    fi
  else
    local why="unknown"
    [ -f "$ev/drive-check" ] && why="$(cat "$ev/drive-check")"
    printf '  FAIL  %s  (%s, evidence %s, sandbox kept at %s)\n' "$feat" "$why" "$ev" "$rd"
    DRIVE_FAILS=$((DRIVE_FAILS + 1))
  fi
}

drive_usage() {
  printf 'usage: control-bee drive (--fast|--full)\n' >&2
  exit 2
}

cmd_drive() {
  [ "$#" -eq 1 ] || drive_usage
  local mode="$1"
  case "$mode" in
    --fast|--full) : ;;
    *) drive_usage ;;
  esac
  [ -x "$(bee_bin)" ] || cmd_build > /dev/null
  DRIVE_FAILS=0
  drive_feature "orient-and-status" drive_orient_and_status
  drive_feature "feature-gates" drive_feature_gates
  drive_feature "cells-and-proof" drive_cells_and_proof
  drive_feature "onboard" drive_onboard
  drive_feature "comment-guard" drive_comment_guard
  drive_feature "worker-outward-guard" drive_worker_outward_guard
  if [ "$mode" = "--full" ]; then
    drive_feature "worktree-and-close" drive_worktree_and_close
    drive_feature "config-layers" drive_config_layers
    drive_feature "semantic-role-routing" drive_semantic_role_routing
    drive_feature "codex-runtime" drive_codex_runtime "cli surface; live canary not driven"
    drive_feature "pi-runtime" drive_pi_runtime
    drive_feature "pi-harness-dispatch" drive_pi_harness_dispatch "live Pi leader not driven"
    drive_feature "pi-hat-wave" drive_pi_hat_wave "live Pi leader not driven"
  fi
  [ "$DRIVE_FAILS" -eq 0 ] || exit 1
}

