  printf 'a note\n' | cmd_put NOTE.md > /dev/null
  drive_expect_exit 0 cmd_sh -- git add -A
  drive_expect_exit 0 cmd_sh -- git commit -qm "add NOTE.md"
  sha="$(cmd_sh -- git rev-parse --short HEAD 2>/dev/null | tr -d '\n')"

  drive_check "bad proof caps refused"
  for t in \
    "test -f NOTE.md — red — touched NOTE.md" \
    "test -f NOTE.md — green — touched NOTE.md" \
    "ran verification manually — green:unit — manual check" \
    "test -f NOTE.md — green:live — checked"; do
    drive_expect_exit 1 cmd_cli -- cells cap --id demo-note-1 --files NOTE.md \
      --report "{\"outcome\":\"note added\",\"commit\":\"$sha\",\"files\":[\"NOTE.md\"],\"tests\":\"$t\",\"deviations\":[]}" --json
  done
  drive_expect_exit 0 cmd_cli -- cells show --id demo-note-1 --json
  [ "$(json_get "$(drive_out)" status)" = "claimed" ]

  drive_check "green:live with evidence caps cell"
  ev="$(evidence_dir)"
  drive_expect_exit 0 cmd_cli -- cells cap --id demo-note-1 --files NOTE.md \
    --report "{\"outcome\":\"note added\",\"commit\":\"$sha\",\"files\":[\"NOTE.md\"],\"tests\":\"test -f NOTE.md — green:live — checked, evidence $ev\",\"deviations\":[]}" \
    --no-mistakes --json
  drive_expect_exit 0 cmd_cli -- cells show --id demo-note-1 --json
  [ "$(json_get "$(drive_out)" status)" = "capped" ]
}

