  drive_check "mismatched cell refused"
  printf '{"id":"demo-note-1","feature":"demo-note","title":"Add a note file","action":"Write NOTE.md","verify":"test -f NOTE.md","lane":"small","role":"code","affects_skills":[],"affects_specs":[]}' \
    | cmd_cli -- cells add --stdin --json > /dev/null 2>&1
