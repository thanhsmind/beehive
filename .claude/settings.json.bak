{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook session-init"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook prompt-context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|Read|Glob|Grep|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook write-guard"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook model-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "update_plan|TaskCreate|TaskUpdate|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook state-sync"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook tools-logger"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook state-sync"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook chain-nudge"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook state-sync"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook session-close"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.bee/bin/bee.exe hook session-close"
          }
        ]
      }
    ]
  }
}
